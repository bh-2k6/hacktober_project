# AI Provider: "ollama" for real AI, "mock" for demo mode
AI_PROVIDER=mock

# Ollama settings (used when AI_PROVIDER=ollama)
AI_MODEL=llava:7b
AI_BASE_URL=http://localhost:11434

# Embedding model for text similarity (used when AI_PROVIDER=ollama)
EMBEDDING_MODEL=nomic-embed-text

# Server settings
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_PATH=data/lost_and_found.db

# Upload settings
UPLOAD_DIR=data/uploads
MAX_IMAGE_SIZE_MB=10
